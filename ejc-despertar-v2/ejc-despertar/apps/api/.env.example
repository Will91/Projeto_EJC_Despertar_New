# Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ejc_despertar?schema=public"

# JWT
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-32+caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte-diferente"
JWT_REFRESH_EXPIRES_IN="30d"

# App
PORT=3333
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# E-mail (opcional — sem isso, os e-mails só são logados no console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="nao-responda@ejcdespertar.org.br"

# Uploads (armazenamento local por padrão — ver docs/09 sobre trocar por S3 em produção)
PUBLIC_UPLOADS_URL="/uploads"
